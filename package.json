{
  "name": "pairable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "biome check --error-on-warnings . && tsc -b",
    "format": "biome check --write .",
    "dev:cell": "pnpm --filter @pairable/cell dev",
    "dev:server": "pnpm --filter @pairable/server dev",
    "dev:web": "pnpm --filter @pairable/web dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
